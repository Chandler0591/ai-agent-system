<?xml version="1.0"?>
<!--
  AGV 小车 URDF 模型 — PyBullet / Gazebo 共用

  与 app/sim_geometry.py 中的 AGV 几何常量保持一致：
  - 车身：box 0.7 x 0.4 x 0.16（半尺寸 0.35/0.2/0.08），质量 1.0kg
  - 4 轮：cylinder r=0.06 厚 0.03（仅视觉），质量 0.1kg，continuous 关节（绕长轴滚动）
  - 车身中心相对机器人原点 z 偏移 +0.12（PyBullet 端加载时再加）

  碰撞体（Gazebo/ODE 生效，PyBullet 忽略 collision 差异）：
  - 车身 collision：0.7 x 0.4 x 0.06，上移 0.05（底在 +0.02），避开轮顶（+0.005）
    ——否则轮子嵌入车身 8.5cm，ODE 轮-车身重叠接触把轮子锁死，车推不动
  - 前轮（fl/fr）万向轮：sphere 碰撞 + mu=0，横向自由滑动——4 个固定 cylinder 轮
    的差速车横向被锁死、原地转不了弯（车只走直线），前轮必须能滑
  - 后轮（bl/br）驱动轮：cylinder 碰撞（与 visual 一致）——球-平面点接触绕法向
    自旋自由、传不了转向力矩（直线 OK、转向废），不能用 sphere
  - 驱动轮关节轴方向：rpy 绕 X 转 -90°（-1.5707963 0 0）使子系 z 轴（轮轴）
    指向父系 +y，与 diff_drive 插件正方向约定一致——命令 +0.5 前进时车真向前；
    绕 X 转 +90°（z→-y）会让 +vel 倒车；负轴 <axis 0 0 -1> 或 rpy 加 180° 偏航
    都会让 ODE 关节马达锁死轮子、车靠马达反扭矩漂移

  驱动（仅 Gazebo 生效，PyBullet 忽略 <gazebo> 标签）：
  - libgazebo_ros_diff_drive 插件：订阅 /cmd_vel、发布 /odom
  - 后轮 wheel_bl/wheel_br 为驱动轮，前轮 wheel_fl/wheel_fr 从动

  颜色：车身颜色由引擎加载后覆盖（changeVisualShape / Gazebo 材质），
  轮子固定深色。
-->
<robot name="agv">

  <!-- ========== 车身 ========== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.7 0.4 0.16"/>
      </geometry>
      <material name="body_color">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.4 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01547" ixy="0.0" ixz="0.0"
               iyy="0.04297" iyz="0.0"
               izz="0.05417"/>
    </inertial>
  </link>

  <!-- ========== 4 个轮子（固定关节，位置对应 AGV_WHEEL_POSITIONS） ========== -->
  <link name="wheel_fl">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000975" ixy="0.0" ixz="0.0"
               iyy="0.00018" iyz="0.0"
               izz="0.0000975"/>
    </inertial>
  </link>

  <link name="wheel_fr">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000975" ixy="0.0" ixz="0.0"
               iyy="0.00018" iyz="0.0"
               izz="0.0000975"/>
    </inertial>
  </link>

  <link name="wheel_bl">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000975" ixy="0.0" ixz="0.0"
               iyy="0.00018" iyz="0.0"
               izz="0.0000975"/>
    </inertial>
  </link>

  <link name="wheel_br">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000975" ixy="0.0" ixz="0.0"
               iyy="0.00018" iyz="0.0"
               izz="0.0000975"/>
    </inertial>
  </link>

  <!-- 轮子摩擦：URDF 默认摩擦在 cylinder-平面 接触下几乎为零，
       轮子扭矩空转推不动车，需显式指定 -->
  <!-- kp/kd 软接触：吸收 spawn 落地冲击（z=0.13 高出触地 1.5cm），
       硬接触下落地会随机弹跳/嵌入，轮子卡死、车漂移（实测 1/3 概率坏 spawn） -->
  <!-- 前轮（fl/fr）是万向轮：球碰撞 + 零摩擦，横向自由滑动，不阻碍差速转向 -->
  <gazebo reference="wheel_fl">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1000.0</kd>
  </gazebo>
  <gazebo reference="wheel_fr">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1000.0</kd>
  </gazebo>
  <gazebo reference="wheel_bl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1000.0</kd>
  </gazebo>
  <gazebo reference="wheel_br">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1000.0</kd>
  </gazebo>

  <!-- 轮子相对车身中心：xy 偏移 ±0.18/±0.13，z 偏移 -0.055（轮心低于车身中心）
       后轮 rpy 绕 X 转 -90°：child Z（cylinder 长轴）→ 父系 +Y（车宽方向），
       与 diff_drive 插件正方向一致（+vel 前进）；
       不能用绕 X 转 +90°（z→-Y，+vel 倒车）也不能 rpy 加 180° 偏航或负轴
       ——都会让 ODE 关节马达锁死轮子、车侧向漂移 -->
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.18 0.13 -0.055" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.18 -0.13 -0.055" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_bl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_bl"/>
    <origin xyz="-0.18 0.13 -0.055" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_br_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_br"/>
    <origin xyz="-0.18 -0.13 -0.055" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ========== 差分驱动插件（仅 Gazebo 生效，PyBullet 忽略） ==========
       订阅 /cmd_vel、发布 /odom；多车场景 spawn 时用 -robot_namespace 区分话题 -->
  <gazebo>
    <plugin name="agv_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>wheel_bl_joint</left_joint>
      <right_joint>wheel_br_joint</right_joint>
      <wheel_separation>0.26</wheel_separation>
      <wheel_diameter>0.12</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>20.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
